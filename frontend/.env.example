# "local" (default) targets a local Anvil node + MockUSDC; "arc" targets Arc testnet.
NEXT_PUBLIC_CHAIN=local

NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_MILESTONES_ADDRESS=
NEXT_PUBLIC_MAINTENANCE_POOL_ADDRESS=
NEXT_PUBLIC_ADMIN_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=

# Profiles database — Postgres (see prisma/schema.prisma). Netlify/Vercel
# both run this app as serverless functions with no persistent filesystem,
# so a local SQLite file doesn't work once deployed; a free instance from
# neon.tech or supabase.com works fine for local dev too.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# GitHub OAuth — create an OAuth App at https://github.com/settings/developers
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_SECRET=
AUTH_URL="http://localhost:3000"
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Shared secret the oracle backend (backend/) presents on its
# /api/internal/* calls — generate with `openssl rand -base64 32`, same
# value goes in backend/.env as INTERNAL_API_SECRET.
INTERNAL_API_SECRET=

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Standard Auth.js (NextAuth v5) Prisma schema, extended with ArcFi profile fields.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  githubLogin     String?
  githubAvatarUrl String?
  bio             String?
  walletAddress   String? @unique

  isSponsor     Boolean @default(false)
  isMaintainer  Boolean @default(false)
  isContributor Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Links a GitHub issue to the on-chain funding event that backs it, so the
// oracle backend can find "is this issue funded, and by which contract/id"
// when a linked PR merges.
model Bounty {
  id                String   @id @default(cuid())
  contractType      String // "escrow" | "milestone"
  onChainIssueId    String
  milestoneId       String?
  githubOwner       String
  githubRepo        String
  githubIssueNumber Int
  status            String   @default("funded") // funded | released | pending_recipient | refunded
  fundedTxHash      String?
  releaseTxHash     String?
  createdByUserId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([githubOwner, githubRepo, githubIssueNumber, status])
}

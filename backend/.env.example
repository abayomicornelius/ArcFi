# GitHub repo webhook secret — set this when adding the webhook at
# github.com/<owner>/<repo>/settings/hooks (Payload URL: this server's
# publicly reachable /webhooks/github, Content type: application/json,
# events: "Pull requests").
GITHUB_WEBHOOK_SECRET=

# The oracle/admin EOA's private key — must match the `admin` address the
# contracts were deployed with (frontend/.env.local's
# NEXT_PUBLIC_ADMIN_ADDRESS). Never commit this.
ADMIN_PRIVATE_KEY=

RPC_URL=http://127.0.0.1:8545
ESCROW_ADDRESS=
MILESTONES_ADDRESS=

# Must match frontend/.env.local's INTERNAL_API_SECRET exactly.
INTERNAL_API_SECRET=
FRONTEND_INTERNAL_URL=http://localhost:3000

PORT=4100

# Optional — a classic or fine-grained PAT with no special scopes needed
# (only reads public commit data). Raises the GitHub API rate limit when the
# oracle resolves a merged PR's commit authors for team-split detection;
# unauthenticated calls work fine at low demo volume without it.
GITHUB_TOKEN=
